# --- IDE / editor -----------------------------------------------------------
.idea/
*.iml
.vscode/

# --- Python cache / bytecode -------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments -----------------------------------------------
venv/
env/
ENV/
.venv/

# --- Build / packaging output --------------------------------------------
build/
dist/
*.egg-info/
*.spec

# --- Windows packaging artifacts (PyInstaller etc.) ------------------------
*.exe
*.dll
*.pyd

# --- Test / lint / type-check caches --------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Logs and temp files --------------------------------------------------
*.log
*.tmp

# --- System files (Windows, macOS) -----------------------------------------
.DS_Store
Thumbs.db

# --- Licensing key material -------------------------------------------------
# The RSA signing key lives here. Whoever holds private_key.pem can mint
# themselves an unlimited licence, so the whole directory is ignored -- not
# just the private half. The *public* key is ignored too, deliberately: it is
# shipped to each site by the installer (into the data/ volume, which
# lpr.license.public_key_candidates checks first), not distributed through a
# public git repository where it would pin every customer to one key pair
# forever.
#
# This section is the fix for the leak that made it into history: the old
# key pair was committed because generate_keys.py documented a protection
# that did not exist here. It exists now, and tests/test_secrets.py asserts
# both this rule and the absence of any PEM in the tree.
keys/
*.pem
*.key
*.pfx
*.p12

# --- Runtime data / models --------------------------------------------------
# data/ and models/ are Docker volumes and local working directories, not repo
# content: camera captures, the sqlite DB, downloaded and fine-tuned weights.
#
# models/ is ignored wholesale rather than by extension. The narrow patterns
# that used to live here (models/*.pt, models/*.onnx) missed the ~98 MB of
# EasyOCR .pth weights sitting one directory down in models/easyocr/, which is
# how they ended up in git without LFS. Fetch every weight with
# scripts/fetch_models.py; nothing in models/ belongs in a commit.
data/
models/
*.pt
*.pt.bak
*.pth
*.onnx
*.engine
*.tflite

# Training artefacts: ultralytics run directories (weights, plots, metrics)
# and downloaded datasets. Produced by scripts/train_plate_detector.py; only
# the finished models/plate_yolov8n.pt matters, and that is ignored above too.
runs/
datasets/
*.db
*.db-wal
*.db-shm

# --- Local secrets ----------------------------------------------------------
# Every .env variant is ignored, .env.example alone is kept. The wildcard
# matters as much as the plain name: .env.production, .env.local and the
# .env.save an editor leaves behind all carry the same live credentials, and
# only the committed template is safe to publish.
#
# The negation must come *after* the wildcard -- git applies the last matching
# rule, so reversing these two lines would silently ignore the template too.
.env
.env.*
!.env.example

# --- Licensing --------------------------------------------------------------
# The active licence key (a signed JWT) and the vendor-side record of every
# key ever generated. Both are secrets: a token in either file is a working
# licence for whoever holds it. license_history.log is also covered by *.log
# above; it is named here so the reason is on the record.
.license
license_history.log

# --- Vendored Windows OCR binaries (removed from the repo) ------------------
# A ~123MB vendored Windows Tesseract-OCR binary tree used to live here.
# The refactored pipeline uses easyocr (see requirements.txt) instead, so
# this directory must never be re-added.
Tesseract-OCR/
