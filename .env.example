# Environment overrides for config.yaml. Copy to `.env` and fill in.
#
#   python scripts/setup_dev.py     # does this copy for you, among other things
#   cp .env.example .env            # ...or by hand
#
# `.env` is gitignored; THIS file is committed, so it must never contain a real
# value. Every secret below is a placeholder — replace them in `.env`, not here.
#
# Environment variables beat config.yaml, which is exactly why secrets belong
# here rather than in the YAML: config.yaml is committed too.
#
# ---------------------------------------------------------------------------
# Every LPR_ variable the service reads is listed below, exactly once, spelled
# the way `Settings` declares it. Commented lines show the built-in default and
# change nothing; uncomment one to override it.
#
# The spelling matters more than it looks. `Settings` is declared
# extra="ignore", so a near miss — LPR_SMTP__TO_ADDRS for to_emails,
# LPR_SMTP__USERNAME for user — is *silently discarded*, the setting keeps
# whatever config.yaml said, and this file claims otherwise. Anything
# unrecognised is named in a warning at startup, and `lpr doctor` lists them on
# demand. tests/test_env_example.py fails if this file and the settings models
# ever disagree, which is what keeps the list above from going stale.
#
# Nesting is a double underscore: LPR_<SECTION>__<FIELD>, and
# LPR_CAMERAS__ENTRY__SOURCE for a section inside a section. List-valued
# settings take JSON: LPR_SMTP__TO_EMAILS=["a@example.com","b@example.com"].
# ---------------------------------------------------------------------------

# --- Required in production -------------------------------------------------
LPR_ENV=production

# Signs the JWTs the API issues. Anyone holding this can mint an admin token,
# which means gate control and (where OTA is enabled) remote code execution.
#   openssl rand -hex 32
LPR_API__SECRET_KEY=replace-with-openssl-rand-hex-32

# --- Licensing --------------------------------------------------------------
# Signs deployment licences. MUST be a different value from the API key above:
# reusing one secret for both means a single leak forges sessions *and*
# licences, and rotating either one forces you to rotate both.
#   openssl rand -hex 32
LPR_LICENSE_SECRET=replace-with-a-different-openssl-rand-hex-32

# Absolute path to public_key.pem, when it lives somewhere unusual. A *path*,
# never key material — nothing secret is read from the environment here.
#LPR_LICENSE_PUBLIC_KEY=/etc/lpr/public_key.pem

# --- Application ------------------------------------------------------------
#LPR_APP__NAME=lpr
# Structured JSON logs. Leave true on a server; false gives human-readable
# lines, which is what you want in a terminal.
#LPR_APP__HEADLESS=true
LPR_APP__LOG_LEVEL=INFO
#LPR_APP__DATA_DIR=data
#LPR_APP__MODELS_DIR=models
# The browser dashboard, served at /web. Blank disables it and serves API only.
LPR_APP__WEB_DIR=web

# --- Cameras ----------------------------------------------------------------
# A camera source is a device index ("0", "1"), an RTSP/HTTP URL, a device node
# (/dev/video0), or a video file. **Blank means "this camera is not fitted"** —
# that is the normal single-camera setup, not an error.
#
# Two rules the service enforces at startup, because both otherwise present as
# an endless reconnect loop that looks like a cable fault:
#
#   * Entry and exit must not name the same physical device. "0" and
#     "/dev/video0" are the same webcam spelled two ways. V4L2 refuses the
#     second opener and DirectShow locks the device outright, so the second
#     role is disabled with a warning rather than left to fail.
#   * A source that is not an index, a device, a URL or an existing file is
#     refused the same way.
#
# Cross-platform: "0" works everywhere. /dev/videoN is rewritten to the bare
# index on Windows, so a config written on Linux still opens the right camera.
LPR_CAMERAS__ENTRY__SOURCE=/dev/video0
LPR_CAMERAS__EXIT__SOURCE=
#LPR_CAMERAS__ENTRY__WIDTH=1280
#LPR_CAMERAS__ENTRY__HEIGHT=720
#LPR_CAMERAS__ENTRY__FPS_LIMIT=15
#LPR_CAMERAS__ENTRY__QUEUE_SIZE=2
# First reconnect delay; subsequent attempts back off exponentially to the max.
#LPR_CAMERAS__ENTRY__RECONNECT_DELAY_S=5.0
#LPR_CAMERAS__ENTRY__RECONNECT_MAX_DELAY_S=60.0
# Seconds without a frame before the watchdog forces a reconnect. 0 disables
# it — which is how a gate goes silently offline behind a TCP connection that
# stays open while the camera stops sending. Leave it on.
#LPR_CAMERAS__ENTRY__STALL_TIMEOUT_S=15.0
# tcp or udp. FFmpeg defaults to UDP, which on a busy or wifi-bridged site
# drops packets and produces torn frames — read errors that look like OCR
# errors. TCP costs a little latency and removes the whole class.
#LPR_CAMERAS__ENTRY__RTSP_TRANSPORT=tcp
# FFmpeg socket timeout for network sources. 0 leaves FFmpeg's default, which
# is no timeout at all.
#LPR_CAMERAS__ENTRY__OPEN_TIMEOUT_S=5.0

#LPR_CAMERAS__EXIT__WIDTH=1280
#LPR_CAMERAS__EXIT__HEIGHT=720
#LPR_CAMERAS__EXIT__FPS_LIMIT=15
#LPR_CAMERAS__EXIT__QUEUE_SIZE=2
#LPR_CAMERAS__EXIT__RECONNECT_DELAY_S=5.0
#LPR_CAMERAS__EXIT__RECONNECT_MAX_DELAY_S=60.0
#LPR_CAMERAS__EXIT__STALL_TIMEOUT_S=15.0
#LPR_CAMERAS__EXIT__RTSP_TRANSPORT=tcp
#LPR_CAMERAS__EXIT__OPEN_TIMEOUT_S=5.0

# Motion gating: skip ML inference on a scene where nothing is happening. A
# gate camera is idle almost all day, and a ~0.1 ms frame-difference check
# removes the overwhelming majority of the inference work.
#LPR_CAMERAS__MOTION__ENABLED=true
# Minimum area of the largest moving contour, in full-frame pixels. 5000 ≈ a
# 70x70 blob.
#LPR_CAMERAS__MOTION__THRESHOLD=5000
# Pass a frame through at least this often even when the scene is still, so a
# frozen feed cannot silently blind the pipeline. 0 disables the heartbeat.
#LPR_CAMERAS__MOTION__HEARTBEAT_S=3.0

# --- Detection --------------------------------------------------------------
# The plate fine-tune. A fresh clone has none — models/ is gitignored — and the
# service starts anyway, on the much weaker contour detector, saying so.
# `GET /api/system/assets` reports exactly which file is missing.
LPR_DETECTION__MODEL_PATH=models/plate_yolov8n.pt
LPR_DETECTION__DEVICE=auto
LPR_DETECTION__CONFIDENCE=0.35
LPR_DETECTION__FRAME_STRIDE=3
#LPR_DETECTION__IOU=0.5
#LPR_DETECTION__IMGSZ=640
# ByteTrack identities, so a plate is recognised once per car rather than once
# per frame.
#LPR_DETECTION__TRACK=true
#LPR_DETECTION__TRACKER=bytetrack.yaml
# Prefer a sibling .onnx export on CPU hosts; ignored on CUDA. Produce the
# export with scripts/export_onnx.py.
#LPR_DETECTION__PREFER_ONNX=true
#LPR_DETECTION__DOWNSCALE_WIDTH=640
#LPR_DETECTION__MAX_OCR_CANDIDATES=3

# --- Preprocessing ----------------------------------------------------------
# Whole-frame enhancement. Off by default: it costs per frame and helps only on
# genuinely dark or hazy installations.
#LPR_PREPROCESS__FRAME_ENHANCE=false
#LPR_PREPROCESS__FRAME_CLAHE_CLIP=2.0
#LPR_PREPROCESS__FRAME_UNSHARP_AMOUNT=0.5
#LPR_PREPROCESS__CROP_UNSHARP_AMOUNT=0.6
#LPR_PREPROCESS__NORMALIZE_LIGHTING=true
#LPR_PREPROCESS__RECTIFY_PERSPECTIVE=true
# Extra crop variants tried only when the first read is unconvincing.
#LPR_PREPROCESS__HARD_CASE_VARIANTS=true
#LPR_PREPROCESS__ESCALATE_BELOW_CONFIDENCE=0.5
#LPR_PREPROCESS__TIGHT_FONT_VARIANT=true
#LPR_PREPROCESS__TIGHT_FONT_KERNEL=[1,3]

# --- OCR --------------------------------------------------------------------
# easyocr or paddleocr. PaddleOCR is the default: measured on 47 labelled
# frames from this site it read 95.7% of plates exactly against EasyOCR's
# 38.3%. EasyOCR needs no extra system packages and remains supported.
LPR_OCR__BACKEND=paddleocr
# true / false / auto. Environment beats config.yaml, so a hard "false" here
# pins the service to CPU no matter what config.yaml says — which is exactly
# how the container ended up logging "EasyOCR (gpu=False)" on a machine with a
# working RTX card. "auto" probes for a usable GPU and falls back to CPU.
LPR_OCR__GPU=auto
LPR_OCR__MIN_CONFIDENCE=0.5
# Turkish plates have no Q, W or X. Narrowing the alphabet is free accuracy.
#LPR_OCR__ALLOWLIST=ABCDEFGHIJKLMNOPRSTUVYZ0123456789
#LPR_OCR__WIDTH_THS=0.5

# Recognition tuning. Every one of these ships OFF -- at the value that
# reproduces the previous behaviour -- because measuring them did not support
# turning any on: the bypass was 59% faster but less accurate, and beamsearch,
# the contrast retry and magnification were neutral to harmful. Measure on
# your own ground truth with scripts/evaluate.py before changing one.
# The crop reaching the OCR layer has already been
# localised by YOLO, so DIRECT_RECOGNIZE skips EasyOCR's own text detector and
# recognises the whole crop as one line -- less latency, and no second set of
# boxes that can clip a glyph. readtext() stays as the fallback when the direct
# call comes back empty, so switching this on cannot lose a read.
#LPR_OCR__DIRECT_RECOGNIZE=false
# beamsearch lets a globally better string win where greedy commits to each
# character on its own -- this is what arbitrates 8/B and 0/O.
#LPR_OCR__DECODER=greedy
#LPR_OCR__BEAM_WIDTH=5
# Below CONTRAST_THS, EasyOCR re-runs a box with its contrast normalised to
# ADJUST_CONTRAST. Raise the threshold on a site with glare or dusk plates.
#LPR_OCR__CONTRAST_THS=0.1
#LPR_OCR__ADJUST_CONTRAST=0.5
# Upscaling before recognition. Plates read at distance arrive below the 64px
# target height, which is where motion blur hurts most.
#LPR_OCR__MAG_RATIO=1.0
# Where EasyOCR caches its ~100 MB of weights. Blank means <models_dir>/easyocr,
# which keeps them on the same volume as the detector's and surviving a
# container rebuild. Pre-fill it with `python scripts/fetch_models.py --easyocr`
# so a cold start is a local file read rather than a download that may hang.
#LPR_OCR__MODEL_DIR=
# Set false on an air-gapped site: EasyOCR then fails loudly on a missing
# weight file instead of hanging on a download that cannot complete.
#LPR_OCR__ALLOW_DOWNLOAD=true
#LPR_OCR__DOWNLOAD_TIMEOUT_S=60.0
# Additional backends to cross-check against. Empty = single backend.
#LPR_OCR__ENSEMBLE_BACKENDS=[]

# --- Voting (yana kayar kapı için 20 sn) ------------------------------------
LPR_VOTING__WINDOW=5
LPR_VOTING__MIN_VOTES=2
LPR_VOTING__TTL_S=4.0
LPR_VOTING__COOLDOWN_S=20.0
#LPR_VOTING__MAX_TRACK_ATTEMPTS=12
#LPR_VOTING__TRACK_TTL_S=30.0
# Single-frame early exit for plates that are already registered. The whitelist
# check is what bounds the risk: a misread has to spell a plate registered at
# this site before the barrier moves. Floored at LPR_OCR__MIN_CONFIDENCE.
LPR_VOTING__FAST_PATH_ENABLED=true
LPR_VOTING__FAST_PATH_CONFIDENCE=0.82
# Whether a fast-path hit may open the barrier on a SINGLE frame, skipping the
# multi-frame vote. Off, and it is the one setting here that can move a gate on
# evidence nothing corroborated. Measured on 47 labelled frames from a live
# site, correct reads scored 0.905-0.999 and the two wrong ones 0.949 and
# 0.955 -- the distributions overlap, so a confident read is not evidence of a
# correct one and no threshold separates them. Turning this off does NOT
# disable the fast path: it still stops the OCR escalation ladder early, which
# is pure latency and has no bearing on the gate.
LPR_VOTING__FAST_PATH_OPENS_GATE=false

#LPR_FAST_PATH__ENABLED=true
#LPR_FAST_PATH__MIN_CONFIDENCE=0.9

# --- Relay / barrier --------------------------------------------------------
#LPR_RELAY__ENABLED=true
# auto, serial, gpio, modbus or http. "auto" probes for a serial device and
# degrades to the mock rather than refusing to start.
#LPR_RELAY__DRIVER=auto
# Refuse to start on a mock relay. Set true on a real gate: a site that
# silently ran on the mock would log every grant and open nothing.
#LPR_RELAY__REQUIRE_HARDWARE=false
LPR_RELAY__PORT=auto
# Never open a real barrier. Correct for development, wrong for a live gate.
LPR_RELAY__MOCK=true
#LPR_RELAY__BAUD=9600
#LPR_RELAY__OPEN_BYTE=A
#LPR_RELAY__CLOSE_BYTE=a
#LPR_RELAY__PULSE_MS=1000
# GPIO driver (Raspberry Pi).
#LPR_RELAY__GPIO_PIN=17
#LPR_RELAY__GPIO_ACTIVE_LOW=true
# Modbus driver.
#LPR_RELAY__MODBUS_MODE=tcp
#LPR_RELAY__MODBUS_HOST=192.168.1.100
#LPR_RELAY__MODBUS_PORT=502
#LPR_RELAY__MODBUS_UNIT=1
#LPR_RELAY__MODBUS_COIL=0
# HTTP driver, for a barrier controller with a web API.
#LPR_RELAY__HTTP_OPEN_URL=
#LPR_RELAY__HTTP_CLOSE_URL=
#LPR_RELAY__HTTP_METHOD=GET
#LPR_RELAY__HTTP_TIMEOUT_S=5.0
#LPR_RELAY__HTTP_USER=
#LPR_RELAY__HTTP_PASSWORD=

# --- E-posta bildirimleri ---------------------------------------------------
# Gmail requires an *app password*, not the account password, and only once
# 2-step verification is on:
#   https://myaccount.google.com/apppasswords
# It is 16 characters, usually shown in four groups of four. Treat it as a
# credential to the whole mailbox: anyone holding it can send as you.
LPR_SMTP__PASSWORD="your-16-char-app-password"

# The rest normally live in config.yaml, which is the right place for them —
# none is a secret. Override here only when a site differs from the committed
# file. Note user, from_email and to_emails in particular, which are easy to
# guess wrong as username, from_addr and to_addrs.
#LPR_SMTP__ENABLED=true
#LPR_SMTP__HOST=smtp.gmail.com
#LPR_SMTP__PORT=587
#LPR_SMTP__USE_TLS=true
#LPR_SMTP__USER=gate@example.com
#LPR_SMTP__FROM_EMAIL=gate@example.com
#LPR_SMTP__TO_EMAILS=["guard@example.com"]
#LPR_SMTP__NOTIFY_ON_UNAUTHORIZED=true
#LPR_SMTP__NOTIFY_ON_BLACKLISTED=true
# Per-message socket timeout. The sender runs on its own thread, so this bounds
# how long a dead mail server can hold one notification, not the pipeline.
#LPR_SMTP__TIMEOUT_S=15.0
# Outgoing queue depth. Oldest is dropped when full, so a mail outage costs
# notifications rather than memory.
#LPR_SMTP__QUEUE_SIZE=64

# --- Storage ----------------------------------------------------------------
LPR_DATABASE__PATH=data/plates.db
LPR_DATABASE__LOG_RETENTION_DAYS=10
LPR_PARKING__CAPACITY=100

# --- Event snapshots --------------------------------------------------------
LPR_SNAPSHOTS__ENABLED=true
# Blank means <data_dir>/snapshots, so repointing the data directory moves the
# images with it.
LPR_SNAPSHOTS__DIR=
LPR_SNAPSHOTS__RETENTION_DAYS=10
LPR_SNAPSHOTS__JPEG_QUALITY=85
LPR_SNAPSHOTS__QUEUE_SIZE=64
# Disk-pressure ceilings, checked before each write. Snapshots are the one
# thing here that grows without bound, and a full disk stops the *database*,
# not just the images — so the writer gives up its own storage first.
# 0 disables either check.
LPR_SNAPSHOTS__MAX_TOTAL_MB=20000
LPR_SNAPSHOTS__MIN_FREE_MB=2000

# --- Anti-passback ----------------------------------------------------------
# Refuse a second entry on a plate that never left. Off by default: it is a
# policy decision, and switching it on at a site with one camera would refuse
# every returning car.
#LPR_ANTI_PASSBACK__ENABLED=false
#LPR_ANTI_PASSBACK__WINDOW_S=43200.0
# Ignore anti-passback entirely while set. For a fire drill or an evacuation.
#LPR_ANTI_PASSBACK__EMERGENCY_BYPASS=false
#LPR_ANTI_PASSBACK__EXEMPT_PLATES=[]

# --- API --------------------------------------------------------------------
#LPR_API__HOST=0.0.0.0
#LPR_API__PORT=8000
# Browser origins allowed to call this API. ["*"] is REFUSED when
# LPR_ENV=production — set the dashboard's real origin, or [] if the API is
# only reached same-origin through the reverse proxy.
#LPR_API__CORS_ORIGINS=["https://gate.example.com"]
#LPR_API__TOKEN_TTL_MIN=720
#LPR_API__ADMIN_TOKEN_TTL_MIN=525600
#LPR_API__OPERATOR_TOKEN_TTL_MIN=480
# Serve /docs and /openapi.json in production. Off by default: the schema is a
# map of every route and role requirement, which is reconnaissance on a live
# site. Turn it on only behind an authenticating proxy.
#LPR_API_DOCS=1

# --- Security ---------------------------------------------------------------
# argon2 or bcrypt. Existing hashes keep verifying either way; changing this
# only affects passwords set from here on.
#LPR_SECURITY__PASSWORD_HASHER=argon2

# --- OTA updates ------------------------------------------------------------
# Off by default, and deliberately: enabling it gives an admin token the
# ability to pull and run new code on this box.
#LPR_SYSTEM_UPDATE__ENABLED=false
#LPR_SYSTEM_UPDATE__REPO_DIR=.
#LPR_SYSTEM_UPDATE__GIT_REMOTE=origin
#LPR_SYSTEM_UPDATE__GIT_BRANCH=main
#LPR_SYSTEM_UPDATE__COMPOSE_FILE=docker/docker-compose.yml
#LPR_SYSTEM_UPDATE__COMPOSE_OVERRIDES=[]
#LPR_SYSTEM_UPDATE__GIT_TIMEOUT_S=120.0
#LPR_SYSTEM_UPDATE__BUILD_TIMEOUT_S=900.0
#LPR_SYSTEM_UPDATE__STATE_FILE=
#LPR_SYSTEM_UPDATE__NIGHTLY_CHECK=true
# Install what the nightly check finds, without asking. Leave false unless the
# site is genuinely unattended.
#LPR_SYSTEM_UPDATE__AUTO_UPDATE=false
#LPR_SYSTEM_UPDATE__CHECK_HOUR=3
#LPR_SYSTEM_UPDATE__CHECK_MINUTE=0
#LPR_SYSTEM_UPDATE__EVENT_RETENTION_DAYS=90

# Engine socket the in-container OTA rebuild talks to, mounted onto
# /var/run/docker.sock inside the container.
#
# The default is the rootless-Podman socket for the host user (uid 1000),
# because that is what this deployment runs. Two reasons it is not
# /var/run/docker.sock: on such a host that path belongs to a different,
# root-owned engine the container cannot open ("permission denied while trying
# to connect to the Docker API"), and if it *could*, it would be rebuilding an
# image nothing is running.
#
# Set this to whatever `echo $DOCKER_HOST` prints on the host. A Docker Engine
# host wants /var/run/docker.sock; a different user id wants its own path.
#LPR_DOCKER_SOCK=/var/run/docker.sock

# --- Alternative config file locations --------------------------------------
# Both are read by application code before Settings is built, so neither is a
# settings field.
#LPR_CONFIG_FILE=/etc/lpr/config.yaml
#LPR_ENV_FILE=/etc/lpr/env

# --- Consumed by docker compose, never by the application -------------------
#LPR_BIND=0.0.0.0
#LPR_PORT=8000
#LPR_VIDEO_GID=44
#LPR_DOCKER_GID=999
#LPR_MEM_LIMIT=4g
#LPR_DOMAIN=gate.example.com
#LPR_ACME_EMAIL=admin@example.com
