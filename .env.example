# Copy to docker/.env (or repo-root .env) and edit. Never commit the real file.
# Every key mirrors config.yaml; env always wins over YAML.
# Nested sections use a double underscore: LPR_<SECTION>__<FIELD>.

# --- Required in production -------------------------------------------------
LPR_ENV=production
LPR_API__SECRET_KEY=replace-with-openssl-rand-hex-32

# --- Licensing --------------------------------------------------------------
# Secret the offline licence keys are signed and verified with. The vendor
# machine running scripts/generate_license.py and the site running the
# service must hold the SAME value, and it must not be shared with customers:
# whoever has it can mint themselves an unlimited licence.
# Falls back to LPR_API__SECRET_KEY when unset. Generate with:
#   openssl rand -hex 32
LPR_LICENSE_SECRET=replace-with-openssl-rand-hex-32

# --- Cameras ----------------------------------------------------------------
# "0" / "1" for a local device index, or a full RTSP/HTTP URL.
LPR_CAMERAS__ENTRY__SOURCE=rtsp://user:pass@192.168.1.50:554/stream1
LPR_CAMERAS__EXIT__SOURCE=rtsp://user:pass@192.168.1.51:554/stream1

# --- Detection / OCR --------------------------------------------------------
LPR_DETECTION__MODEL_PATH=models/plate_yolov8n.pt
LPR_DETECTION__DEVICE=auto
LPR_DETECTION__CONFIDENCE=0.35
LPR_DETECTION__FRAME_STRIDE=3
LPR_OCR__BACKEND=easyocr
LPR_OCR__GPU=false
LPR_OCR__MIN_CONFIDENCE=0.5

# --- Voting (multi-frame confirmation before the gate opens) ----------------
LPR_VOTING__WINDOW=5
LPR_VOTING__MIN_VOTES=3
LPR_VOTING__TTL_S=4.0
LPR_VOTING__COOLDOWN_S=10.0

# --- Relay ------------------------------------------------------------------
# Windows: COM3.  Linux: /dev/ttyUSB0.  "auto" resolves per-OS.
# Inside a container on a Windows host there is no serial passthrough,
# so run the container with MOCK=true and drive the relay from the host.
LPR_RELAY__PORT=auto
LPR_RELAY__MOCK=false

# --- Storage ----------------------------------------------------------------
LPR_DATABASE__PATH=data/plates.db
LPR_DATABASE__LOG_RETENTION_DAYS=10
LPR_APP__LOG_LEVEL=INFO
# Browser dashboard, served at /web. Empty disables it (API only).
LPR_APP__WEB_DIR=web
# Default site capacity; an admin can override it at runtime from the
# dashboard, which stores the value in the database. 0 = unlimited.
LPR_PARKING__CAPACITY=100

# --- Event snapshots (one JPEG per gate decision) ----------------------------
# Images outgrow the database quickly; point DIR at another disk if needed.
# Empty DIR means <LPR_APP__DATA_DIR>/snapshots.
LPR_SNAPSHOTS__ENABLED=true
LPR_SNAPSHOTS__DIR=
LPR_SNAPSHOTS__RETENTION_DAYS=10
LPR_SNAPSHOTS__JPEG_QUALITY=85
LPR_SNAPSHOTS__QUEUE_SIZE=64
